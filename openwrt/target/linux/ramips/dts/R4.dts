/dts-v1/;

#include "mt7628an.dtsi"

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>

/ {
	compatible = "OEM,MT7628", "mediatek,mt7628an-soc";
	model = "R4";

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x4000000>;
	};

	gpio-leds {
		compatible = "gpio-leds";
		hwdog {
			label = "oem:green:hwdog";
			gpios = <&gpio1 5 GPIO_ACTIVE_LOW>;
		};

		wifi {
			label = "oem:green:wifi";
			gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
		};

		wan {
			label = "oem:green:wan";
			gpios = <&gpio1 7 GPIO_ACTIVE_LOW>;
		};

		lan {
			label = "oem:green:lan";
			gpios = <&gpio1 9 GPIO_ACTIVE_LOW>;
		};

		signal1 {
			label = "oem:green:signal1";
			gpios = <&gpio0 4 GPIO_ACTIVE_LOW>;
		};

		signal2 {
			label = "oem:green:signal2";
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
		};

		signal3 {
			label = "oem:green:signal3";
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
		};

		signal4 {
			label = "oem:green:signal4";
			gpios = <&gpio1 11 GPIO_ACTIVE_LOW>;
		};
	};

	gpio_export {
		compatible = "gpio-export";
		#size-cells = <0>;

		usb4g {
			gpio-export,name = "4g";
			gpio-export,output = <1>;
			gpios = <&gpio0 0 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-keys-polled {
		compatible = "gpio-keys-polled";
		#address-cells = <1>;
		#size-cells = <0>;
		poll-interval = <20>;
		reset {
			label = "reset";
			gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&ethernet {
	mtd-mac-address = <&bdinfo 0xDE00>;
	mediatek,port-map = "wllll";
};

&pinctrl {
	state_default: pinctrl0 {
		gpio {
			ralink,group = "refclk", "wled_an", "gpio";
			ralink,function = "gpio";
		};
	};
};

&spi0 {
	status = "okay";

	m25p80@0 {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <10000000>;
		m25p,chunked-io = <32>;

		partition@0 {
			label = "u-boot";
			reg = <0x0 0x30000>;
		};

		partition@30000 {
			label = "u-boot-env";
			reg = <0x30000 0x10000>;
		};

		factory: partition@40000 {
			label = "factory";
			reg = <0x40000 0x10000>;
		};

		bdinfo: partition@7f0000 {
			label = "bdinfo";
			reg = <0x7f0000 0x10000>;
		};

		partition@50000 {
			label = "firmware";
			reg = <0x50000 0x7a0000>;
		};
	};
};

#!/bin/sh

. /lib/functions.sh
. /lib/ramips.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

ramips_setup_interfaces()
{
	local board="$1"

	case "$board" in
	R9 | R19 | R25 | R42 | R46)
		ucidef_add_switch "switch0" \
			"0:lan" "1:lan" "2:lan" "4:lan" "3:wan" "6@eth0"
		;;
	R4 | R7 | R26)
		ucidef_add_switch "switch0" \
			"0:lan:3" "1:lan:2" "2:lan:1" "3:lan:0" "4:wan" "6@eth0"
		;;
	R10 | R23 | R48)
		ucidef_add_switch "switch0" \
			"0:lan:3" "1:lan:2" "2:lan:1" "3:lan:0" "4:wan" "6@eth0"
		;;
	R11 | R13 | R15 | R16 | R17 | R18 | R27 | R28 | R29 | R30 | R30 | R33 | R37 | R38 | R39 | R45)
		ucidef_add_switch "switch0" \
			"0:lan" "1:lan" "2:lan" "3:lan" "4:wan" "6@eth0"
		;;
	R42 | R61 | R67)
		ucidef_add_switch "switch0" \
			"1:lan:3" "2:lan:2" "3:lan:1" "0:wan" "6@eth0"
		;;
	R46)
		ucidef_add_switch "switch0" \
			"0:lan" "1:wan" "6@eth0"
		;;
	R66)
		ucidef_add_switch "switch0" \
			"1:lan" "0:wan" "6@eth0"
		;;
	R6)
		ucidef_add_switch "switch0" \
			"1:lan" "2:lan" "3:lan" "0:wan" "6@eth0"
		;;
	*)
		ucidef_add_switch "switch0" \
			"1:lan" "2:lan" "3:lan" "4:lan" "0:wan" "6@eth0"
		;;
	esac
}

board_config_update
board=$(ramips_board_name)
ramips_setup_interfaces $board
board_config_flush

exit 0
